{
  "name": "las-lomas-gym",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca de ejercicios en video de Las Lomas Gym. Se accede escaneando un QR, sin login.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node scripts/catalog.mjs && vite",
    "catalog": "node scripts/catalog.mjs",
    "build": "node scripts/catalog.mjs --strict && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.*\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "optimize": "node scripts/optimize.mjs",
    "qr": "node scripts/qr.mjs"
  },
  "devDependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@types/node": "^22.10.0",
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.149.0"
  }
}
