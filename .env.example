# Carpeta con los videos que se publican (se puede apuntar a una carpeta de Windows).
# Las subcarpetas se usan como categorías: videos/Piernas/Sentadilla.mp4 -> categoría "Piernas".
VIDEOS_DIR="/mnt/c/Users/PC/Desktop/Videos Gym"

# Dónde se sirven los videos en producción.
#   - "/videos/" si los videos se suben junto con la web (COPY_VIDEOS=1).
#   - URL pública de un bucket (ej. Cloudflare R2): https://videos.laslomasgym.com/
VIDEO_BASE_URL="/videos/"

# 1 = copia los videos dentro de dist/videos al hacer `npm run build`.
COPY_VIDEOS=1

# Carpeta con los videos originales del profe (solo la usa `npm run optimize`).
RAW_VIDEOS_DIR=""

# URL final de la web, para generar el QR.
SITE_URL="https://laslomasgym.pages.dev"

# Publicación en Cloudflare Pages (solo si `npx wrangler login` no funciona, por ejemplo en WSL).
# Token: dash.cloudflare.com/profile/api-tokens → Create Custom Token → permiso "Account · Cloudflare Pages · Edit".
# ¡Nunca subir estos valores a git ni pegarlos en un chat! (.env está en .gitignore)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
